{
  "name": "map_tiles_lvgl8",
  "version": "2.0.0",
  "description": "Offline map tiles, smooth map widget, routes and turn-by-turn matching for LVGL 8.x (Arduino / PlatformIO port of 0015/map_tiles)",
  "keywords": "lvgl, map, tiles, gps, navigation, offline, route, esp32",
  "license": "MIT",
  "authors": [{ "name": "Eric Nam (original map_tiles)" }],
  "frameworks": ["arduino"],
  "platforms": ["espressif32"],
  "dependencies": { "lvgl/lvgl": "^8.3.11" },
  "headers": "MapTiles.h",
  "examples": [{ "name": "TileGrid", "base": "examples/TileGrid", "files": ["TileGrid.ino"] },
               { "name": "MapViewFollow", "base": "examples/MapViewFollow", "files": ["MapViewFollow.ino"] },
               { "name": "Navigation", "base": "examples/Navigation", "files": ["Navigation.ino"] }]
}
